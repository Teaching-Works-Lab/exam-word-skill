{
  "_comment": "试卷三层流水线配置模板。复制到工作区后按课程改路径/命令。workdir 相对本文件所在目录；{python} 自动替换为当前解释器，{soffice} 自动替换（顶层 soffice 字段可覆盖，默认 macOS LibreOffice 路径）。",
  "paper": "（课程名）期末试卷",
  "workdir": ".",
  "manifest": ".pipeline-manifest.json",
  "layer_order": ["design", "content", "render"],
  "design": {
    "_comment": "L1 命题设计：知识点划分/双向细目/题量排序/分值配比。inputs 是这一层的人工产出源。",
    "inputs": ["blueprint.md", "syllabus.md"],
    "gates": []
  },
  "content": {
    "_comment": "L2 题目生成：spec/objective/answers 三源。门禁含来源对齐、答案分布、内容质量、代码完整性。",
    "inputs": ["spec-A.json", "objective-A.json", "answers-A.json", "answer-A.md"],
    "gates": [
      ["{python}", "scripts/check_answer_distribution.py", "answers-A.json"],
      ["{python}", "scripts/check_paper_content.py", "spec-A.json", "objective-A.json", "answer-A.md", "--blueprint", "blueprint.json", "--gate-mode", "alignment"]
    ]
  },
  "render": {
    "_comment": "L3 格式渲染：build→派生答案→去子题干加粗→PDF；门禁含代码排版、模板保真、PDF逐页，最后必须跑 check_final_gate（§15.6 长约束：读成品文本查 Markdown/HTML/AI 残留）。任一失败即 fail-fast。",
    "inputs": ["spec-A.json", "answers-A.json"],
    "build": [
      ["{python}", "scripts/build_code_exam.py", "spec-A.json", "paper-A.docx"],
      ["{python}", "scripts/derive_answer_keyed_from_docx.py", "paper-A.docx", "answers-A.json", "paper-A-answer.docx"],
      ["{python}", "scripts/unbold_substems.py", "paper-A.docx", "paper-A-answer.docx"],
      ["{soffice}", "--headless", "--convert-to", "pdf", "paper-A.docx", "--outdir", "."],
      ["{soffice}", "--headless", "--convert-to", "pdf", "paper-A-answer.docx", "--outdir", "."]
    ],
    "gates": [
      ["{python}", "scripts/check_code_layout.py", "paper-A.docx", "--body-indent", "283"],
      ["{python}", "scripts/verify_docx.py", "paper-A.docx", "assets/reference.docx"],
      ["{python}", "scripts/check_pdf_pages.py", "paper-A.pdf", "--min-last-page-chars", "60"],
      ["{python}", "scripts/check_pdf_pages.py", "paper-A-answer.pdf", "--min-last-page-chars", "60"],
      ["{python}", "scripts/check_final_gate.py", "paper-A.docx", "paper-A-answer.docx"]
    ]
  }
}
